{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ohnoo-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "landing", "run", "dev", "--", "--host", "127.0.0.1", "--port", "5174"],
      "port": 5174,
      "url": "http://127.0.0.1:5174"
    },
    {
      "name": "ohnoo-docs-static",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8200", "--directory", "docs", "--bind", "127.0.0.1"],
      "port": 8200,
      "url": "http://127.0.0.1:8200"
    }
  ]
}
